// AMD Radeon (Light) - the same layers in soft greys, one red accent, slanted buttons.
// (How skins are written: see the top of AMD Radeon.)

name: AMD Radeon (Light)
description: Glint's own look in light: soft greys, one red accent, slanted buttons
dark: false

// ---- colours
accent: #e3262d
accent-text: #ffffff
background: #e9e9ec
title-bar: background
toolbar: #f5f5f7
panel: #ffffff
sidebar: background
status-bar: background
input: panel
button: #e6e6ea
button-hover: #dcdce1
text: #1d1d1f
text-bright: #1d1d1f
muted: #6b6b73
disabled: #b8b8be
selection: accent 12%
selection-edge: accent
hover: #f3f3f5
tool-hover: #e6e6ea
tool-pressed: #dcdce1
path-hover: #ededf0
line: #e0e0e4
scrollbar: #c6c6cc
scrollbar-hover: #a9a9b0
usage-bar: #dcdce1
logo: accent
logo-letters: accent-text
tab-line: accent
toolbar-line: accent
caption-hover: button-hover
caption-pressed: button-hover 70%
close-hover: accent
menus: light

// ---- shapes and text
shape: slanted
slant: 8
path-slant: 6
radius: 6
row-height: 28
tab-line-width: 3
toolbar-line-width: 2
font: Segoe UI Variable Text, Segoe UI
font-size: 9pt
